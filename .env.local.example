# Copy this file to .env.local and fill in the values.
#   cp .env.local.example .env.local
#
# Values come from Supabase → Project Settings → API.
# Never commit .env.local — only this example is tracked.

# --- Supabase (public — safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (server-only — powers admin result scoring; keep secret) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- App URL (used for OAuth redirects) ---
# Local dev: http://localhost:3000  |  Production: https://your-app.vercel.app
# On Vercel this falls back to VERCEL_URL automatically if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Results sync (API-Football) ---
# Free key from https://dashboard.api-football.com (header x-apisports-key).
API_FOOTBALL_KEY=your-api-football-key
# Shared secret that protects /api/cron/sync-results. Generate any long random string,
# e.g.  openssl rand -hex 32  — set the SAME value in Vercel and the GitHub Action secret.
CRON_SECRET=your-long-random-secret
